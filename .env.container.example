# Copy to .env.container. Create each referenced file with an independent
# 64-character token, keep the directory out of Git, and restrict its ACL.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
PA_API_TOKEN_SECRET_FILE=.secrets/api_token
PA_MYSQL_PASSWORD_SECRET_FILE=.secrets/mysql_password
PA_MYSQL_ROOT_PASSWORD_SECRET_FILE=.secrets/mysql_root_password

# Host port only; compose.yaml always publishes it on host loopback.
PA_DOCKER_API_PORT=8000
PA_API_ALLOWED_HOSTS=127.0.0.1,localhost
PA_API_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:1420,http://localhost:1420
# 部署域名示例：
# PA_API_ALLOWED_HOSTS=agent.example.com,127.0.0.1,localhost
# PA_API_ALLOWED_ORIGINS=https://tauri.localhost,tauri://localhost,http://tauri.localhost
PA_ALLOW_PUBLIC_REGISTRATION=true
PA_AUTH_SESSION_TTL_HOURS=168
PA_CLAIM_LEGACY_DATA_ON_FIRST_USER=false
PA_LOG_RETENTION_DAYS=30
PA_AUDIT_LOG_RETENTION_DAYS=90
PA_SECURITY_CLEANUP_INTERVAL_SECONDS=3600

# Default: use an Ollama service already running on the host.
PA_OLLAMA_BASE_URL=http://host.docker.internal:11434
PA_LLM_MODEL=qwen2.5:14b-instruct-q4_K_M
PA_EMBED_MODEL=bge-m3
PA_LLM_CONTEXT_LENGTH=8192

# To use the optional pinned GPU container instead, set the URL below and run:
# docker compose --env-file .env.container --profile ollama-gpu up -d
# PA_OLLAMA_BASE_URL=http://ollama:11434

# Modernized paths remain off until the schema/quality rollout is authorized.
PA_AGENT_RUNS_API_ENABLED=false
PA_AGENT_RUN_READ_ONLY_TOOLS_ENABLED=false
PA_AGENT_RAG_TOOLS_ENABLED=false
PA_AGENT_CONTEXT_BUILDER_ENABLED=false
PA_CHAT_AGENT_RUNTIME_ENABLED=false
PA_CONVERSATION_SUMMARY_WORKER_ENABLED=false
PA_CONVERSATION_SUMMARY_ALLOW_REMOTE_PROVIDER=false
PA_VERSIONED_RAG_INDEXING_ENABLED=false
PA_VERSIONED_RAG_RETRIEVAL_ENABLED=false
PA_MCP_ENABLED=true
PA_LOG_LEVEL=INFO
