# 复制为 smtp.env 后填写；该文件已被 .gitignore 排除，禁止提交授权码。
# 源码运行：项目根 smtp.env
# Windows 安装版：%APPDATA%\personal-assistant\smtp.env
# 服务器部署：也可将同名 PA_SMTP_* 变量注入服务进程环境。

# 常见示例：QQ 邮箱 smtp.qq.com:465；163 邮箱 smtp.163.com:465。
# smtp.example.com 只是占位符，不能直接使用；主机值不要带 http:// 或 https://。
PA_SMTP_HOST=smtp.example.com
PA_SMTP_PORT=465
PA_SMTP_USE_SSL=true
PA_SMTP_STARTTLS=false

# SMTP 登录邮箱与服务商生成的授权码（通常不是网页登录密码）。
PA_SMTP_USERNAME=your-account@example.com
PA_SMTP_PASSWORD=replace-with-smtp-authorization-code

# 发件地址一般与登录邮箱相同。
PA_SMTP_FROM_EMAIL=your-account@example.com
PA_SMTP_FROM_NAME=PrivateAgent
PA_SMTP_TIMEOUT_SECONDS=15
