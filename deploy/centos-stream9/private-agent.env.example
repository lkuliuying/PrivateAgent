# CentOS Stream 9 source deployment example.
# Copy to /etc/private-agent/private-agent.env, replace agent.example.com,
# and keep this file readable only by root:privateagent (0640).

PA_DATA_DIR=/var/lib/private-agent

# Uvicorn stays on loopback. Nginx is the only public listener.
PA_API_HOST=127.0.0.1
PA_API_PORT=8000
PA_API_AUTH_ENABLED=true
PA_API_TOKEN_FILE=/etc/private-agent/api-token
PA_API_ALLOWED_HOSTS=agent.example.com,127.0.0.1,localhost
PA_API_ALLOWED_ORIGINS=https://agent.example.com:6000,https://tauri.localhost,http://tauri.localhost,tauri://localhost

# Leave true only until the first administrator account has been registered.
PA_ALLOW_PUBLIC_REGISTRATION=true
PA_AUTH_SESSION_TTL_HOURS=168
PA_CLAIM_LEGACY_DATA_ON_FIRST_USER=false

# File logs and database audit records are purged independently.
PA_LOG_RETENTION_DAYS=30
PA_AUDIT_LOG_RETENTION_DAYS=90
PA_SECURITY_CLEANUP_INTERVAL_SECONDS=3600

# The password is read from the separate 0640 secret file, not this URL.
PA_DB_URL=mysql+aiomysql://privateagent@127.0.0.1:3306/personal_assistant?charset=utf8mb4
PA_DB_PASSWORD_FILE=/etc/private-agent/mysql-password

# Ollama can run on this server or another private server address.
PA_OLLAMA_BASE_URL=http://127.0.0.1:11434
PA_LLM_MODEL=qwen2.5:14b-instruct-q4_K_M
PA_EMBED_MODEL=bge-m3
PA_LLM_TEMPERATURE=0.7
PA_LLM_CONTEXT_LENGTH=8192

# Keep high-risk coding capabilities disabled until server project paths,
# command profiles, backup, and recovery procedures have been verified.
PA_AGENT_RUNS_API_ENABLED=false
PA_CHAT_AGENT_RUNTIME_ENABLED=false
PA_PROJECT_BOUND_RUNS_ENABLED=false
PA_AGENT_RUN_PLAN_ENABLED=false
PA_AGENT_RUN_EVENT_STREAM_ENABLED=false
PA_CODING_PATCHSET_ENABLED=false
PA_CODING_COMMAND_PROFILES_ENABLED=false
PA_CODING_ARTIFACTS_ENABLED=false
PA_CODING_PERMISSION_MODELS_ENABLED=false
PA_CODING_AGENT_UI_ENABLED=false
PA_CODING_WORKSPACE_AUTO_APPROVE_ENABLED=false
PA_CODING_FULL_ACCESS_ENABLED=false
PA_CODING_CONTEXT_BUDGET_ENABLED=false
PA_CODING_EXECUTION_DETAIL_ENABLED=false
PA_CODING_WORKTREE_ENABLED=false
