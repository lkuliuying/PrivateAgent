{
  "$defs": {
    "CapabilitySnapshot": {
      "additionalProperties": false,
      "properties": {
        "execution": {
          "default": false,
          "title": "Execution",
          "type": "boolean"
        },
        "model_streaming": {
          "default": false,
          "title": "Model Streaming",
          "type": "boolean"
        },
        "output_streaming": {
          "default": false,
          "title": "Output Streaming",
          "type": "boolean"
        },
        "protocol_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Protocol Version",
          "type": "string"
        },
        "pty": {
          "default": false,
          "title": "Pty",
          "type": "boolean"
        },
        "recovery": {
          "default": false,
          "title": "Recovery",
          "type": "boolean"
        },
        "stdin": {
          "default": false,
          "title": "Stdin",
          "type": "boolean"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolCapability"
          },
          "maxItems": 128,
          "title": "Tools",
          "type": "array"
        }
      },
      "title": "CapabilitySnapshot",
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "description": "只接受内容寻址标识，不允许模型提供任意文件路径。",
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "bytes"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "ContextItem": {
      "additionalProperties": false,
      "properties": {
        "content_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "execution_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Id"
        },
        "item_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "message",
            "instruction",
            "tool_call",
            "tool_result",
            "summary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "ordinal": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "session_id": {
          "minimum": 1,
          "title": "Session Id",
          "type": "integer"
        },
        "source": {
          "enum": [
            "user",
            "project_instruction",
            "model",
            "tool",
            "summary",
            "legacy"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_sequence": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sequence"
        },
        "summary_of": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "title": "Summary Of",
          "type": "array"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "item_id",
        "session_id",
        "run_id",
        "ordinal",
        "role",
        "kind",
        "content_ref",
        "source",
        "created_at"
      ],
      "title": "ContextItem",
      "type": "object"
    },
    "EventEnvelope": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9_.]{0,127}$",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "sequence",
        "type"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "content_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "execution_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Id"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "source_sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Source Sequence",
          "type": "integer"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "verified_at": {
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        },
        "workspace_version": {
          "minimum": 0,
          "title": "Workspace Version",
          "type": "integer"
        }
      },
      "required": [
        "evidence_id",
        "run_id",
        "operation_id",
        "source_sequence",
        "content_ref",
        "verified_at",
        "workspace_version"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "command_kind": {
          "default": "unclassified",
          "enum": [
            "test",
            "search",
            "development",
            "unclassified"
          ],
          "title": "Command Kind",
          "type": "string"
        },
        "execution_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Execution Id",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "exited",
            "timed_out",
            "cancelled",
            "failed",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "validation_outcome": {
          "default": "unknown",
          "enum": [
            "succeeded",
            "failed",
            "unknown"
          ],
          "title": "Validation Outcome",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "operation_id",
        "outcome"
      ],
      "title": "ExecutionResult",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_policy": {
          "default": "manual",
          "enum": [
            "disk",
            "exit",
            "test_exit",
            "response",
            "manual"
          ],
          "title": "Evidence Policy",
          "type": "string"
        },
        "kind": {
          "default": "manual",
          "enum": [
            "file_changed",
            "command",
            "test",
            "artifact",
            "preview",
            "manual"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "default": "legacy",
          "enum": [
            "user",
            "intent_rule",
            "tool",
            "legacy"
          ],
          "title": "Origin",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "scope": {
          "default": "",
          "maxLength": 2000,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "description"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "RunOutcome": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 256,
          "title": "Evidence Refs",
          "type": "array"
        },
        "goal_outcome": {
          "enum": [
            "answered",
            "verified",
            "unmet",
            "blocked",
            "unknown"
          ],
          "title": "Goal Outcome",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "maxItems": 128,
          "title": "Requirements",
          "type": "array"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unverified_items": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Unverified Items",
          "type": "array"
        },
        "verification_results": {
          "items": {
            "$ref": "#/$defs/VerificationResult"
          },
          "maxItems": 128,
          "title": "Verification Results",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "goal_outcome"
      ],
      "title": "RunOutcome",
      "type": "object"
    },
    "ToolCapability": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolCapability",
      "type": "object"
    },
    "VerificationResult": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Evidence Ids",
          "type": "array"
        },
        "message": {
          "default": "",
          "maxLength": 2000,
          "title": "Message",
          "type": "string"
        },
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "unverified"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "status"
      ],
      "title": "VerificationResult",
      "type": "object"
    },
    "WorkspaceIdentity": {
      "additionalProperties": false,
      "properties": {
        "canonical_path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Canonical Path",
          "type": "string"
        },
        "git_available": {
          "title": "Git Available",
          "type": "boolean"
        },
        "initial_dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Dirty"
        },
        "initial_head": {
          "anyOf": [
            {
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Head"
        },
        "project_id": {
          "minimum": 1,
          "title": "Project Id",
          "type": "integer"
        },
        "root_path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Root Path",
          "type": "string"
        },
        "workspace_id": {
          "minimum": 1,
          "title": "Workspace Id",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "workspace_id",
        "root_path",
        "canonical_path",
        "git_available"
      ],
      "title": "WorkspaceIdentity",
      "type": "object"
    }
  },
  "$id": "urn:private-agent:coding:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
