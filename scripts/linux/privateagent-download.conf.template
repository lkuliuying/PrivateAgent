server {
    listen 80;
    server_name __DOWNLOAD_DOMAIN__;
    root /srv/privateagent-download;
    autoindex off;

    location = /latest.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri =404;
    }
}
