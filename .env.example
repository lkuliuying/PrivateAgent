# === 本地后端 API ===
PA_API_HOST=127.0.0.1
PA_API_PORT=8000

# === MySQL ===
# 注意：驱动用 aiomysql（纯 Python）。密码请改为本机 root 实际密码。
PA_DB_URL=mysql+aiomysql://root:YOUR_PASSWORD@127.0.0.1:3306/personal_assistant?charset=utf8mb4

# === Ollama ===
PA_OLLAMA_BASE_URL=http://127.0.0.1:11434
PA_LLM_MODEL=qwen2.5:14b-instruct-q4_K_M
PA_EMBED_MODEL=bge-m3
PA_LLM_TEMPERATURE=0.7
PA_LLM_CONTEXT_LENGTH=8192

# === 数据目录（chroma / logs 派生于此） ===
# 开发模式默认 ./data；打包模式默认 %APPDATA%/personal-assistant（Windows）。
# 一般留空即可，仅在需要强制指定时取消注释：
# PA_DATA_DIR=./data

# === 知识库默认开关 ===
PA_KB_ENABLED_BY_DEFAULT=false

# === 日志 ===
PA_LOG_LEVEL=INFO
