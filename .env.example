# === 本地后端 API ===
PA_API_HOST=127.0.0.1
PA_API_PORT=8000
# 仅供容器网络命名空间使用：允许容器内绑定 0.0.0.0/::，同时强制开启认证。
# 桌面端和源码开发保持 false；不得用它直接暴露局域网或公网端口。
PA_API_ALLOW_NON_LOOPBACK_BIND=false
# 打包应用会由 Tauri 为每次 sidecar 启动注入 256-bit 随机令牌，无需写入磁盘。
# 手动启动开发后端时，请设置至少 32 字符的共享令牌，并在 Vite 中配置 VITE_API_TOKEN。
# PA_API_TOKEN=replace-with-at-least-32-random-characters
# 容器可改用 secret file；与 PA_API_TOKEN 二选一。
# PA_API_TOKEN_FILE=/run/secrets/api_token
# 仅限明确接受风险的纯浏览器开发；默认认证保持开启。
# PA_API_AUTH_ENABLED=false
# PA_API_ALLOWED_HOSTS=127.0.0.1,localhost
# PA_API_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
# 多用户认证：首个注册账号成为管理员；完成初始化后可关闭公开注册。
PA_ALLOW_PUBLIC_REGISTRATION=true
PA_AUTH_SESSION_TTL_HOURS=168
# 从旧本地库迁移时，只有明确希望首个管理员认领 owner 为空的旧数据才开启。
PA_CLAIM_LEGACY_DATA_ON_FIRST_USER=false
# 新 AgentRun API 默认关闭；仅在开发验证新运行链路时显式开启。
# PA_AGENT_RUNS_API_ENABLED=true
# 新 Runtime 的首批只读工具单独默认关闭；仅迁移 search/grep/git 读取能力。
# PA_AGENT_RUN_READ_ONLY_TOOLS_ENABLED=true
# PA_AGENT_RAG_TOOLS_ENABLED=true
# 新 ContextBuilder 只接管 AgentRun，默认关闭；预算是输入上下文的保守 token 上限。
# PA_AGENT_CONTEXT_BUILDER_ENABLED=true
# PA_AGENT_CONTEXT_MAX_TOKENS=6000
# 最终答案非空验证默认关闭；开启后无效候选不发送，最多受控修正 0-2 次。
# PA_AGENT_OUTPUT_VERIFICATION_ENABLED=true
# PA_AGENT_OUTPUT_VERIFICATION_MAX_RETRIES=1
# 旧聊天到 AgentRuntime 的兼容映射另设开关；当前仅覆盖无 RAG/无工具结果的开发聊天。
# PA_CHAT_AGENT_RUNTIME_ENABLED=true
# 可追溯会话摘要 worker 默认关闭；需要 schema 0017+。自动摘要默认只调用本地 Ollama。
# PA_CONVERSATION_SUMMARY_WORKER_ENABLED=true
# PA_CONVERSATION_SUMMARY_ALLOW_REMOTE_PROVIDER=false
# PA_CONVERSATION_SUMMARY_TICK_SECONDS=60
# PA_CONVERSATION_SUMMARY_MIN_SOURCE_MESSAGES=12
# PA_CONVERSATION_SUMMARY_KEEP_RECENT_MESSAGES=8
# PA_CONVERSATION_SUMMARY_MAX_SOURCE_MESSAGES=40
# PA_CONVERSATION_SUMMARY_MAX_SOURCE_CHARS=24000
# MCP registry/client API is enabled by default. Trust, enable, and allowlist each server explicitly.
PA_MCP_ENABLED=true

# === MySQL ===
# 仅用于源码开发和测试；Windows 安装版由 Tauri 从系统凭据库注入，不会把密码写入配置文件。
# 注意：驱动用 aiomysql（纯 Python）。开发时请把密码改为本机 root 实际密码。
PA_DB_URL=mysql+aiomysql://root:YOUR_PASSWORD@127.0.0.1:3306/personal_assistant?charset=utf8mb4
# 容器可让 URL 不含密码，并通过 secret file 在进程内安全组装；两种密码来源不可并用。
# PA_DB_PASSWORD_FILE=/run/secrets/mysql_password
# 后端测试专用；留空时安全派生为 personal_assistant_test。禁止指向上面的应用数据库。
# PA_TEST_DB_URL=mysql+aiomysql://root:YOUR_PASSWORD@127.0.0.1:3306/personal_assistant_test?charset=utf8mb4

# === Ollama ===
PA_OLLAMA_BASE_URL=http://127.0.0.1:11434
PA_LLM_MODEL=qwen2.5:14b-instruct-q4_K_M
PA_EMBED_MODEL=bge-m3
PA_LLM_TEMPERATURE=0.7
PA_LLM_CONTEXT_LENGTH=8192

# === 数据目录（chroma / logs 派生于此） ===
# 开发模式默认 ./data；打包模式默认 %APPDATA%/personal-assistant（Windows）。
# 一般留空即可，仅在需要强制指定时取消注释：
# PA_DATA_DIR=./data

# === 知识库默认开关 ===
PA_KB_ENABLED_BY_DEFAULT=false
# 版本化 RAG 分阶段开关：先旁路构建并验证，再单独打开在线检索。
PA_VERSIONED_RAG_INDEXING_ENABLED=false
PA_VERSIONED_RAG_RETRIEVAL_ENABLED=false
PA_VERSIONED_RAG_RETENTION_DAYS=14
PA_VERSIONED_RAG_MIN_RETIRED_VERSIONS=1

# === RAG 证据充分性（R2.1 无答案拒答） ===
# 开启后检索层对重排后的最终分数（0..1）做"证据不足"判断，证据不足时返回
# 空来源 + 结构化原因（evidence_insufficient / single_channel_weak / no_results），
# 回答层明确说明"资料不足"，不生成弱引用。默认值经 2026-08-06 真实语料校准
# （已知答案 0.906+，无答案 0.761–0.848）；语义反转类干扰（高分双渠道）是
# 分数策略已知局限，需语义蕴含级验证。
PA_RAG_EVIDENCE_ENABLED=false
PA_RAG_EVIDENCE_MIN_FINAL_SCORE=0.80
PA_RAG_EVIDENCE_MIN_SINGLE_CHANNEL_SCORE=0.85

# === R3 预算口径与遥测持久化 ===
# token 估算安全系数：真实 usage 抽样校准后默认 2.0 保证保守上界（见
# data/rehearsals/r3-tokenizer-20260806/report.json）。
PA_TOKEN_ESTIMATE_SAFETY_FACTOR=2.0
# 兼容遥测持久化（schema 0021+）：每进程一个观察窗口，定期落库，退出标记 ended_at；
# 用于 §6.4 跨版本 legacy 归零观察（scripts/telemetry_window_report.py）。
# 下次启动时 reconcile 早于宽限期仍未 ended_at 的陈旧窗口（异常退出被回收）。
PA_COMPATIBILITY_TELEMETRY_PERSIST_ENABLED=false
PA_COMPATIBILITY_TELEMETRY_FLUSH_SECONDS=60
PA_COMPATIBILITY_TELEMETRY_RECONCILE_GRACE_SECONDS=7200

# === 日志 ===
PA_LOG_LEVEL=INFO
PA_LOG_RETENTION_DAYS=30
PA_AUDIT_LOG_RETENTION_DAYS=90
PA_SECURITY_CLEANUP_INTERVAL_SECONDS=3600

# === 注册邮箱验证码（推荐单独复制 smtp.env.example 为 smtp.env 后填写） ===
# 应用会在主 .env 之后自动读取 smtp.env；授权码不要提交到仓库。
# PA_SMTP_HOST=smtp.example.com
# PA_SMTP_PORT=465
# PA_SMTP_USE_SSL=true
# PA_SMTP_STARTTLS=false
# PA_SMTP_USERNAME=your-account@example.com
# PA_SMTP_PASSWORD=replace-with-smtp-authorization-code
# PA_SMTP_FROM_EMAIL=your-account@example.com
# PA_SMTP_FROM_NAME=PrivateAgent
# PA_SMTP_TIMEOUT_SECONDS=15

# === v0.9.0 Coding Agent 默认切换与可靠性（计划 §1.3/§3.3/§5.3） ===
# 能力可用性声明，不是权限授予：默认权限模式仍为 confirm，不扩大既有
# trusted path/命令 profile。安装版经发布门禁后默认开启（桌面侧车注入），
# 显式置 false 即精确回退；依赖顺序：project-bound → 其余 flag。
# PA_PROJECT_BOUND_RUNS_ENABLED=true
# PA_AGENT_RUN_PLAN_ENABLED=true
# PA_AGENT_RUN_EVENT_STREAM_ENABLED=true
# PA_AGENT_COMMAND_WORKFLOW_ENABLED=true
# PA_CODING_PATCHSET_ENABLED=true
# 单文件真实写入（审批前展示 Diff，写后回读校验）
# PA_AGENT_PATCH_WORKFLOW_ENABLED=true
# PA_CODING_COMMAND_PROFILES_ENABLED=true
# PA_CODING_ARTIFACTS_ENABLED=true
# PA_CODING_PERMISSION_MODELS_ENABLED=true
# PA_CODING_AGENT_UI_ENABLED=true
# 替我批准（workspace）真实自动批准能力位（额外要求命令 profile 子系统）
# PA_CODING_WORKSPACE_AUTO_APPROVE_ENABLED=true
# 完全访问（full_access）独立能力：授予/撤销/到期/审计（不是 workspace 别名）
# PA_CODING_FULL_ACCESS_ENABLED=true
# PA_CODING_FULL_ACCESS_TTL_MINUTES=240
# 上下文 budget/compaction 公开端点与事件（真实 token 用量，不伪造）
# PA_CODING_CONTEXT_BUDGET_ENABLED=true
# PA_CODING_EXECUTION_DETAIL_ENABLED=true
# 可选 Git worktree（显式创建/清理，模型无 Git 管理权限）
# PA_CODING_WORKTREE_ENABLED=true

# ---- v1.0 Agent 架构专项 Feature Flags（专项计划 §20）----
# 模型工具能力探测（随模型配置保存自动执行；快照进入工具面门禁）
# PA_AGENT_V2_MODEL_PROBE_ENABLED=true
# 工具快照诊断 API（observe-only，脱敏；不改变执行语义）
# PA_AGENT_V2_TOOL_SNAPSHOT_ENABLED=false
# v2 Tool Engine 主链接入（默认关；关闭时执行面维持 v0.9 dispatcher）
# PA_AGENT_V2_TOOL_ENGINE_ENABLED=false
# 写入预检门禁（当前阶段默认开= enforce；关闭回落 v0.9 无预检形态）
# PA_AGENT_V2_TOOL_PREFLIGHT_ENABLED=true
# 副作用完成证据门禁（当前阶段默认开= enforce；关闭回落 v0.9 条件族，
# 同样非 fail-open；一旦 enforce 不得对副作用任务 fail-open）
# PA_AGENT_V2_COMPLETION_EVIDENCE_ENABLED=true
# Rust Exec Host 接入（默认关；通用命令仍受沙箱门禁失败关闭约束）
# PA_AGENT_V2_EXEC_HOST_ENABLED=false
# Deferred Tool Search 接入模型面（P1，默认关）
# PA_AGENT_V2_DEFERRED_TOOL_SEARCH_ENABLED=false
# 只读工具安全并发（默认关=恒串行；开启需基准通过）
# PA_AGENT_V2_SAFE_PARALLEL_TOOLS_ENABLED=false
# native apply-patch 自由格式（默认关，不进普通用户设置；需 probe 证明后重决策）
# PA_AGENT_V2_NATIVE_APPLY_PATCH_ENABLED=false
# Codex App Server 隔离 Spike（dev-only，默认关；当前结论 Defer）
# PA_AGENT_CODEX_APP_SERVER_SPIKE_ENABLED=false
