{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrivateAgent",
  "version": "0.4.0-alpha.2",
  "identifier": "com.personal-assistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "私人助手",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/personal-assistant-server"],
    "publisher": "Personal Assistant",
    "copyright": "© 2026 Personal Assistant",
    "category": "Productivity",
    "shortDescription": "本地优先的私人助手",
    "longDescription": "私人助手 Agent —— 本地优先、隐私可控的桌面个人助手（Tauri + Python + Ollama + MySQL + ChromaDB）。",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/lkuliuying/PrivateAgent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMTU3NzVGNzI3NjY0MUYKUldRZlpIWnlYM2NWWGhjd0NBL3U1OFF4S0w1eXV2N3MwSnFiUThDN0hTbXR4aGFMYksxNVhuK2EK",
      "dialog": false
    }
  }
}
